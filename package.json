{
	"name": "obsidian-image-assistant",
	"version": "6.0.0",
	"private": true,
	"description": "Process images and create editable Draw.io or Excalidraw drawings in Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "eslint src/**/*.ts --fix",
		"pre-release": "node scripts/prepare-release.js",
		"test": "vitest run",
		"test:clean": "vitest run --reporter=tap",
		"test:json": "vitest run --reporter=json",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json --noEmit",
		"check:scripts": "node --check scripts/obsidian-runtime-smoke.js && node --check scripts/obsidian-layout-diagnostic.js && node --check scripts/obsidian-native-resize-smoke.js && node --check scripts/verify-release-metadata.js && node --check scripts/prepare-release.js && node --check scripts/deploy-local.js",
		"deploy:local": "npm run build && node scripts/deploy-local.js",
		"smoke:obsidian": "node scripts/obsidian-runtime-smoke.js",
		"smoke:obsidian-native-resize": "node scripts/obsidian-native-resize-smoke.js",
		"diagnose:obsidian-layout": "node scripts/obsidian-layout-diagnostic.js",
		"verify:release": "node scripts/verify-release-metadata.js",
		"check": "npm run lint && npm run typecheck && npm run typecheck:test && npm run check:scripts && npm run test:coverage && npm run build && npm run verify:release -- --build && npm audit --omit=optional"
	},
	"keywords": [
		"obsidian",
		"images",
		"drawio",
		"excalidraw",
		"ocr"
	],
	"author": "RandyAllen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RandyAllenEEE/obsidian-image-assistant.git"
	},
	"bugs": {
		"url": "https://github.com/RandyAllenEEE/obsidian-image-assistant/issues"
	},
	"homepage": "https://github.com/RandyAllenEEE/obsidian-image-assistant#readme",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.10.6",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^10.0.1",
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^24.3.1",
		"@types/path-browserify": "^1.0.3",
		"@types/piexifjs": "^1.0.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitest/coverage-v8": "3.2.7",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.9",
		"eslint": "^10.8.0",
		"globals": "^16.3.0",
		"happy-dom": "20.10.6",
		"obsidian": "1.13.1",
		"typescript": "^5.9.2",
		"vitest": "3.2.7"
	},
	"dependencies": {
		"ai": "6.0.100",
		"cross-spawn": "^7.0.6",
		"fabric": "7.4.0",
		"image-type": "^6.1.0",
		"path-browserify": "^1.0.1",
		"piexifjs": "^1.0.6"
	},
	"overrides": {
		"@vitest/coverage-v8@3.2.7": {
			"test-exclude": "8.0.0"
		}
	}
}
