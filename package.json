{
	"name": "obsidian-image-assistant",
	"version": "5.1.1",
	"description": "Convert, compress, resize, annotate, upload, download, caption, and OCR images directly in Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "eslint src/**/*.ts --fix",
		"pre-release": "node scripts/prepare-release.js",
		"test": "vitest run",
		"test:clean": "vitest run --reporter=tap",
		"test:json": "vitest run --reporter=json",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json --noEmit",
		"check:scripts": "node --check scripts/obsidian-runtime-smoke.js && node --check scripts/verify-release-metadata.js && node --check scripts/prepare-release.js && node --check scripts/deploy-local.js",
		"deploy:local": "npm run build && node scripts/deploy-local.js",
		"smoke:obsidian": "node scripts/obsidian-runtime-smoke.js",
		"verify:release": "node scripts/verify-release-metadata.js",
		"check": "npm run lint && npm run typecheck && npm run typecheck:test && npm run check:scripts && npm run test:coverage && npm run build && npm run verify:release -- --build && npm audit --omit=optional"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.10.6",
		"@eslint/js": "^9.35.0",
		"@faker-js/faker": "^10.0.0",
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^24.3.1",
		"@types/path-browserify": "^1.0.3",
		"@types/piexifjs": "^1.0.0",
		"@types/sortablejs": "^1.15.8",
		"@typescript-eslint/eslint-plugin": "^8.42.0",
		"@typescript-eslint/parser": "^8.42.0",
		"@vitest/coverage-v8": "3.2.7",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.9",
		"eslint": "^9.35.0",
		"globals": "^16.3.0",
		"happy-dom": "20.10.6",
		"obsidian": "1.11.4",
		"sortablejs": "^1.15.6",
		"tslib": "2.4.0",
		"typescript": "^5.9.2",
		"vitest": "3.2.7"
	},
	"dependencies": {
		"cross-spawn": "^7.0.6",
		"fabric": "7.4.0",
		"image-type": "^6.1.0",
		"path-browserify": "^1.0.1",
		"piexifjs": "^1.0.6"
	}
}
